# Semaphore MCP Server Configuration

# Required: Semaphore UI base URL (without /api suffix)
SEMAPHORE_URL=http://localhost:3000

# Required: API token (Bearer token)
SEMAPHORE_TOKEN=your_api_token_here

# Optional: Enable debug logging
# DEBUG=true

# Optional: Read-only mode (default: true)
# READ_ONLY=true
